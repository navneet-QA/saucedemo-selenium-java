<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Automation Suite" parallel="classes" thread-count="2">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
    </listeners>

    <test name="Positive Scenarios">
        <classes>
            <class name="com.framework.tests.positive.LoginPositiveTest"/>
            <class name="com.framework.tests.positive.CartPositiveTest"/>
            <class name="com.framework.tests.positive.SortingAndDetailsTest"/>
            <class name="com.framework.tests.positive.CheckoutPositiveTest"/>
        </classes>
    </test>

    <test name="Negative Scenarios">
        <classes>
            <class name="com.framework.tests.negative.LoginNegativeTest"/>
            <class name="com.framework.tests.negative.CheckoutNegativeTest"/>
        </classes>
    </test>

</suite>
